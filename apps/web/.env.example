# ===========================================
# Hisham Academy – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ===========================================

# Neon / PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required for signed HttpOnly sessions (academy booking + auth)
# Generate with: openssl rand -base64 32
ACADEMY_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Auth.js secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-another-long-random-secret

# Public URL of the deployed site
AUTH_URL=http://localhost:4000

# Must be PRODUCTION in production
NEXT_PUBLIC_CREATE_ENV=PRODUCTION

# Optional: comma-separated allowed origins for CORS
CORS_ORIGINS=

# Optional – only needed if using remaining Anything integrations
ANYTHING_PROJECT_TOKEN=
