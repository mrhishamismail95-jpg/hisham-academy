# Shared production env for Railway / Render / Fly / Docker
# Set these in the platform dashboard (never commit real values)

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ACADEMY_SESSION_SECRET=   # openssl rand -base64 32
AUTH_SECRET=              # openssl rand -base64 32
AUTH_URL=https://your-app.up.railway.app
NEXT_PUBLIC_CREATE_ENV=PRODUCTION
CORS_ORIGINS=https://your-app.up.railway.app
PORT=3000
NODE_ENV=production
